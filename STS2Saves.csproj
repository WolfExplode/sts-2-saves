<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>NyMod.Saves</RootNamespace>
    <AssemblyName>STS2Saves</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS0108;CS0114;CS0472;CS0184;CS8509;CS0219</NoWarn>
    <Sts2GameDir Condition="'$(Sts2GameDir)' == ''">$(STS2_GAME_DIR)</Sts2GameDir>
    <Sts2GameDir Condition="'$(Sts2GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</Sts2GameDir>
    <Sts2DataDir Condition="$([MSBuild]::IsOSPlatform('Windows'))">data_sts2_windows_x86_64</Sts2DataDir>
    <Sts2Dir>$(Sts2GameDir)/$(Sts2DataDir)</Sts2Dir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.4.0">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Lib.Harmony" Version="2.4.2">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2Dir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="STS2Saves.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Code\NyMod\Saves\Infrastructure\Localization\Resources\STS2Saves.localization.eng.sts2_saves_ui.json">
      <LogicalName>STS2Saves.localization.eng.sts2_saves_ui.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Code\NyMod\Saves\Infrastructure\Localization\Resources\STS2Saves.localization.zhs.sts2_saves_ui.json">
      <LogicalName>STS2Saves.localization.zhs.sts2_saves_ui.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
