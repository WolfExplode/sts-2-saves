<Project Sdk="Godot.NET.Sdk/4.5.1">
  <!--
    STS2Saves IMPLEMENTATION project. Builds one DLL per supported game version
    (selected via -p:Sts2Version=v0.103.2 etc). The thin entry assembly that
    the game's mod loader sees lives in EntryProj/STS2Saves.Entry.csproj.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>

    <!-- Per-version build inputs. Set Sts2Version on the command line: -p:Sts2Version=v0.104.0 -->
    <Sts2Version Condition="'$(Sts2Version)' == ''">v0.103.2</Sts2Version>
    <Sts2VersionDir>$(MSBuildThisFileDirectory)..\game-versions\$(Sts2Version)</Sts2VersionDir>

    <ModId>STS2Saves</ModId>
    <AssemblyName>$(ModId).$(Sts2Version)</AssemblyName>
    <RootNamespace>NyMod.Saves</RootNamespace>
    <OutputPath>bin\$(Configuration)\$(Sts2Version)\</OutputPath>

    <!-- Per-version capability flags drive #if blocks in the compat layer. -->
    <!-- Per-version preprocessor symbols (STS2_V<N>, STS2_V_GE_<N>) come from
         Directory.Build.props at the workspace root. -->
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2VersionDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(Sts2VersionDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Suppress SDK default content-copy globs so localization JSONs do NOT land in
         mods/STS2Saves/, where the game's recursive ModManager would mistakenly try
         to load them as mod manifests (and log [ERROR] for each). They are read at
         runtime from the embedded resource stream, not from disk. -->
    <None Remove="localization\**\*.json" />
    <Content Remove="localization\**\*.json" />
    <EmbeddedResource Include="localization\**\*.json" />

    <!-- The Entry project compiles its own files; skip them here. -->
    <Compile Remove="EntryProj\**\*.cs" />
    <None Remove="EntryProj\**\*" />
  </ItemGroup>

  <!-- Stage the per-version sidecar manifest next to the impl DLL so the
       packing step (scripts/Pack-Mods.ps1) picks it up alongside the DLL. -->
  <Target Name="Stage Impl Manifest" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(Sts2VersionDir)\version.manifest.json" DestinationFiles="$(OutputPath)$(AssemblyName).dll.manifest" />
  </Target>
</Project>